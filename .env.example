# ───── الزامی ─────
# توکن ربات از @BotFather
BOT_TOKEN=123456:ABC-your-token
# رمز دائمی سازنده (حداقل ۱۲ کاراکتر، تصادفی و طولانی). فقط در اولین اجرا خوانده و با bcrypt هش می‌شود.
SUPER_LICENSE=change-me-to-a-long-random-secret

# ───── اختیاری ─────
# ریست رمز فراموش‌شده: مقدار جدید را در SUPER_LICENSE بگذارید، این را 1 کنید، یک‌بار ری‌استارت کنید، سپس حذفش کنید.
RESET_SUPER_LICENSE=0
# آیدی کانال خصوصی بک‌آپ آرشیو چت‌ها (مثل -1001234567890). ربات باید ادمین کانال باشد.
BACKUP_CHANNEL_ID=
# بک‌آپ شبانهٔ دیتابیس اصلی در همان کانال (0 یا 1)
BACKUP_DB_DAILY=0
# مسیر ذخیره داده‌ها. روی Railway یک Volume روی /data بسازید.
DATA_DIR=./data
TIMEZONE=Asia/Tehran
# ساعت یادآور صبحگاهی
MORNING_HOUR=8
# سقف مشاور در هر دفتر (شامل لایسنس‌های استفاده‌نشده)
MAX_AGENTS_PER_OFFICE=10
