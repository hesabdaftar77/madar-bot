"""موتور تطبیق پیشرفته با قابلیت فیلتر دقیق (Exact) و فازی (Fuzzy با تلورانس)."""

def score_match_advanced(c: dict, p: dict, tolerance_percent: int = 0) -> dict | None:
    if c["deal_type"] != p["deal_type"]:
        return None
    
    # بررسی تطبیق بودجه/قیمت با در نظر گرفتن تلورانس
    budget_ok = False
    price_val = p.get("price") or p.get("deposit") or 0
    budget_max = c.get("budget_max") or c.get("deposit_max") or 0
    
    if budget_max > 0:
        max_allowed = budget_max * (1 + tolerance_percent / 100.0)
        if price_val <= max_allowed:
            budget_ok = True

    # بررسی متراژ با تلورانس
    area_ok = False
    p_area = p.get("area") or 0
    min_a = (c.get("min_area") or 0) * (1 - tolerance_percent / 100.0)
    max_a = (c.get("max_area") or 99999) * (1 + tolerance_percent / 100.0)
    if min_a <= p_area <= max_a:
        area_ok = True

    # بررسی منطقه
    region_ok = False
    c_regions = [r.strip() for r in (c.get("region") or "").split(",") if r.strip()]
    p_region = (p.get("region") or "").strip()
    if not c_regions or any(r in p_region for r in c_regions):
        region_ok = True

    score = 0
    if budget_ok: score += 40
    if region_ok: score += 30
    if area_ok: score += 30

    return {"score": score, "exact": (tolerance_percent == 0 and score == 100)}
